# Copiar a backend/.env y cambiar la clave. backend/.env no se versiona.
POSTGRES_USER=coffecrop
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=coffecrop

# Misma clave que POSTGRES_PASSWORD; el puerto 5433 es el publicado por docker-compose.yml.
DATABASE_URL=postgresql://coffecrop:cambia-esta-clave@127.0.0.1:5433/coffecrop
